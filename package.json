{
  "name": "peeps",
  "version": "1.0.0",
  "description": "Family-centered social platform",
  "private": true,
  "scripts": {
    "dev": "clear && pnpm --filter @peeps/web generate:themes && turbo run dev --filter=@peeps/web",
    "dev:web": "clear && pnpm --filter @peeps/web generate:themes && turbo run dev --filter=@peeps/web",
    "dev:socket": "turbo run dev --filter=@peeps/socket",
    "dev:mobile": "turbo run dev --filter=@peeps/mobile",
    "dev:all": "clear && pnpm --filter @peeps/web generate:themes && turbo run dev --filter=@peeps/web --filter=@peeps/socket",
    "kill": "lsof -ti :3001,4100 | xargs kill -9 2>/dev/null || true",
    "clean": "find . -type d \\( -name .next -o -name .turbo \\) -prune -exec rm -rf {} +",
    "build:web": "turbo run build --filter=@peeps/web",
    "build:mobile": "turbo run build --filter=@peeps/mobile",
    "build": "turbo run build",
    "lint:web": "turbo run lint --filter=@peeps/web",
    "lint:mobile": "turbo run lint --filter=@peeps/mobile",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "lint:policy": "eslint .",
    "db:generate": "pnpm --filter @peeps/db db:generate",
    "db:migrate": "pnpm --filter @peeps/db db:migrate",
    "db:push": "pnpm --filter @peeps/db db:push",
    "db:studio": "pnpm --filter @peeps/db db:studio",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "generate:themes": "pnpm --filter @peeps/web generate:themes"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.1.0",
    "turbo": "latest"
  },
  "packageManager": "pnpm@8.0.0",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "dependencies": {
    "mongodb": "^7.1.0"
  }
}
