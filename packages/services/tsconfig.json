{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "experimentalDecorators": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@peeps/config": ["../config/src"],
      "@peeps/config/env": ["../config/env.ts"],
      "@peeps/config/constants/*": ["../config/constants/*"],
      "@peeps/types": ["../types/src"],
      "@peeps/types/*": ["../types/*"],
      "@peeps/utils": ["../utils/src"],
      "@peeps/utils/*": ["../utils/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
