{
  "compilerOptions": {
    "target"         : "ES2020",
    "module"         : "node16",
    "lib"            : ["ES2020"],
    "moduleResolution": "node16",
    "types"          : ["node"],
    "outDir"         : "./dist",
    "rootDir"        : "./src",
    "strict"         : true,
    "esModuleInterop": true,
    "skipLibCheck"   : true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
